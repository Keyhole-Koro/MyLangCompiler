// A mutable borrow returned by at_mut() keeps the vector mutably borrowed.
import { Option } from "@std/core/option.mln";
import { Slice } from "@std/memory/slice.mln";
i32 main() {
    i32 storage[2];
    storage[0] = 1; storage[1] = 2;
    Slice<i32> s;
    s.init(&storage[0], 2);
    Option<borrow mut i32> a = s.at_mut(0);
    borrow Slice<i32> view = &s; // s is already mutably borrowed through a
    return 0;
}
