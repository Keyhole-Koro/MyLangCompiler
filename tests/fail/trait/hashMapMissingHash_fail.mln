import { Eq } from "@std/core/cmp.mln";
import { Hash } from "@std/core/hash.mln";
import { HashMap } from "@std/collections/hashmap.mln";

struct Key { i32 value; };

impl Eq for Key {
    bool (borrow Key self) eq(borrow Key other) { return self.value == other.value; }
}

/* Key deliberately omits `impl Hash`. Specializing HashMap must reject it. */
i32 main() {
    HashMap<Key, i32> map;
    return map.len;
}
