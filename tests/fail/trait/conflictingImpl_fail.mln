// Two impls of the same trait and arguments for one type conflict.
trait Eq { bool (borrow Self self) eq(borrow Self other); }
struct P { i32 x; };
impl Eq for P { bool (borrow P self) eq(borrow P other) { return true; } }
impl Eq for P { bool (borrow P self) eq(borrow P other) { return true; } }
i32 main() { return 0; }
