// Implementing a trait from another source tree for a type from another
// source tree is the orphan case: neither side is this tree's to extend.
import { Eq } from "@std/core/cmp.mln";
import { AllocationError } from "@std/memory/allocator.mln";

impl Eq for AllocationError {
    bool (AllocationError *self) eq(AllocationError *other) { return true; }
}

i32 main() { return 0; }
