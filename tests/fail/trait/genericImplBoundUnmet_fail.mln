// `impl<T: Eq> Eq for Box<T>` gives Box<Opaque> no Eq: Opaque has none.
import { Eq } from "@std/core/cmp.mln";

struct Opaque { i32 v; };
struct Box<T> { T value; };

impl<T: Eq> Eq for Box<T> {
    bool (Self self) eq(Self other) { return self.value == other.value; }
}

i32 same<T: Eq>(T *a, T *b) { if (*a == *b) { return 1; } return 0; }

i32 main() {
    Box<Opaque> a = Box<Opaque> { value: Opaque { v: 1 } };
    return same<Box<Opaque>>(&a, &a);
}
