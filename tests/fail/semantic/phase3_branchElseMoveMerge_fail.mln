import { Drop } from "@std/core/drop.mln";
typedef struct {
    i32 x;
} Box;

/* A drop() makes Box an owned value, which moves instead of copying
 * (rule V2 of docs/design/mylang-memory-model.md). */
impl Drop for Box { void (borrow mut Self self) drop() { } }

void consume(Box b) {
    b.x = b.x;
}

i32 main() {
    Box a;
    a.x = 7;
    i32 cond = 0;

    if (cond) {
        cond = 1;
    } else {
        consume(a);
    }

    return a.x; // invalid: a may have been moved by the else branch
}
