import { Drop } from "@std/core/drop.mln";
typedef struct {
    i32 x;
} Box;

/* A drop() makes Box an owned value, which moves instead of copying
 * (rule V2 of docs/design/mylang-memory-model.md). */
impl Drop for Box { void (Self *self) drop() { } }

void consume(Box b) {
    b.x = b.x;
}

i32 main() {
    Box a;
    a.x = 7;
    consume(a);
    return a.x; // invalid: a is moved into consume(a), so using a afterwards must fail
}
