// Rule B4: the same through a local that holds the borrow.
import { Vec } from "@std/collections/vec.mln";
import { Option } from "@std/core/option.mln";

i32 main() {
    Vec<i32> v = Vec<i32> {};
    borrow Vec<i32> r = &v;
    Option<borrow i32> first = r.at(0);
    r.push(1);
    return case first of { Some(x) -> *x; None -> 0; };
}
