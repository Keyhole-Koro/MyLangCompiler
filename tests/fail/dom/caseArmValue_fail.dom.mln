// An element written as a `case` arm's value would be hoisted ahead of the
// whole statement and built whichever arm runs, so it is rejected:
// "a DOM element is only allowed as a value inside a statement". Written as a
// statement expression, `1 -> ({ yield (<Text .../>); })`, it is lowered.
import dom from "../../support/dom/dom.mln";

i32 f(i32 k) {
    return case k of {
        1 -> (<Text text="a" x={1} y={2} />);
        _ -> 0;
    };
}
