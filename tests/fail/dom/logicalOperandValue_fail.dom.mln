// An element written as the right operand of && or || would be hoisted ahead
// of the whole statement and built even when the left operand decides, so it
// is rejected: "a DOM element is only allowed as a value inside a statement".
// Written as a statement expression, `k && ({ yield (<Text .../>) > 0; })`,
// it is lowered.
import dom from "../../support/dom/dom.mln";

i32 f(i32 k) {
    return k && (<Text text="a" x={1} y={2} />);
}
