// Element vocabulary for the @app cases: defaults on every geometry
// parameter, handler slots recorded so a case can call them back.
package dom;
i32 g_last_owner = 0;
fn(i32 owner, i32 id, i32 arg) -> void g_last_click = 0;
i32 g_last_id = 0;
i32 g_next = 1;
@safe
export void append_child(i32 p, i32 c) { }
@safe
export i32 Window(str title, i32 x = 0, i32 y = 0, i32 w = 320, i32 h = 200) { i32 id = g_next; g_next++; return id; }
@safe
export i32 Button(str text, i32 x = 0, i32 y = 0, i32 w = 90, i32 h = 34, fn(i32 owner, i32 id, i32 arg) -> void onClick = 0) { i32 id = g_next; g_next++; g_last_click = onClick; g_last_id = id; return id; }
@safe
export i32 Label(str text, i32 x = 0, i32 y = 0, i32 color = 0, i32 bold = 0) { i32 id = g_next; g_next++; return id; }
@safe
export fn(i32 owner, i32 id, i32 arg) -> void last_click() { return g_last_click; }
@safe
export i32 last_id() { return g_last_id; }
