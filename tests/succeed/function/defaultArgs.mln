// Positional calls fill trailing `= literal` defaults, for local, exported
// and package-imported functions alike.
package defaults;
import lib from "../../support/app/lib.mln";
i32 local_add(i32 a, i32 b = 10) { return a + b; }
export i32 exported_add(i32 a, i32 b = 20) { return a + b; }
i32 main() {
    // 11 + (5*3-1=14) + (2*2-1=3) + (1*1+1=2) + 21 + (4*3-1=11) = 62
    return local_add(1) + lib.scale(5) + lib.scale(2, 2) + lib.scale(1, 1, 1) + exported_add(1) + lib.scale(4);
}
