// The parts of the containers and views that no program in the tree calls yet.
import { Vec } from "@std/collections/vec.mln";
import { Arena } from "@std/memory/arena.mln";
import { Option } from "@std/core/option.mln";
import mbin from "@std/format/mbin.mln";
import str from "@std/text/str.mln";

i32 g_items[4];
i32 g_pool[3];

i32 vec_checks() {
    Vec<i32> v;
    v.init(&g_items[0], 4);
    if (v.len() != 0) { return 1; }
    v.push(5);
    v.push(6);
    if (v.len() != 2) { return 2; }
    {
        i32 seen = case v.at(1) of { Some(value) -> value; None -> 0; };
        if (seen != 6) { return 3; }
    }
    bool past_end = case v.at(2) of { Some(_) -> false; None -> true; };
    if (!past_end) { return 4; }
    return 0;
}

i32 arena_checks() {
    Arena<i32> a;
    a.init(&g_pool[0], 3);
    bool first = case a.alloc(3) of { Some(_) -> true; None -> false; };
    bool over = case a.alloc(1) of { Some(_) -> true; None -> false; };
    if (!first || over) { return 1; }
    a.reset();
    bool again = case a.alloc(3) of { Some(_) -> true; None -> false; };
    if (!again) { return 2; }
    return 0;
}

i32 str_checks() {
    str word = "abc";
    u8 middle = case word.byte_at(1) of { Some(value) -> value; None -> (u8)0; };
    if (middle != (u8)'b') { return 1; }
    bool past_end = case word.byte_at(3) of { Some(_) -> false; None -> true; };
    if (!past_end) { return 2; }
    return 0;
}

char g_image[32];

// An MBIN header keeps its words big-endian; the BSS size is at offset 28.
i32 mbin_checks() {
    g_image[30] = (char)1;
    g_image[31] = (char)2;
    str image = str { data: &g_image[0], length: 32 };
    if (mbin.bss_size(image) != 258) { return 1; }
    return 0;
}

i32 main() {
    return vec_checks() * 1000 + arena_checks() * 100 + str_checks() * 10 + mbin_checks();
}
