// `break` inside a statement-expression case arm leaves the enclosing loop.
// gen_stmt() carries no loop labels, so the codegen keeps the innermost
// loop's in the compiler context; without that the break was silently
// dropped and the arm's value was garbage.
import { Option } from "../../../../MyStdLib/option.mln";

Option<i32> f(i32 x) { if (x < 2) { return Some(x + 5); } return None; }

i32 main() {
    i32 sum = 0;
    i32 i = 0;
    while (i < 5) {
        i32 a = case f(i) of { Some(v) -> v; None -> ({ break; }); };
        sum = sum * 10 + a;
        i++;
    }
    return sum * 10 + i;   // 5, 6, then break at i == 2: 562
}
