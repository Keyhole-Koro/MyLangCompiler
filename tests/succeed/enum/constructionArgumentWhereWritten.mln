// A construction runs where it is written. What it carries is evaluated only
// when its arm, branch or operand runs, and on every pass of a loop.
import { Option } from "@std/core/option.mln";

i32 g_calls = 0;
i32 g_sum = 0;

i32 next() { g_calls = g_calls + 1; return g_calls; }
i32 read(Option<i32> value) { return case value of { Some(v) -> v; None -> 0; }; }
void note(Option<i32> value) { g_sum = g_sum + read(value); }
Option<i32> same(Option<i32> value) { return value; }

i32 chosen(i32 which) {
    return case which of {
        1 -> read(Some(next()));
        2 -> 50;
        _ -> read(Some(next() + 100));
    };
}

i32 main() {
    i32 total = chosen(2);                                         // 50, no call
    total = total + chosen(1);                                     // 51, call 1
    total = total + (g_calls == 1 ? 7 : read(Some(next())));       // 58, no call
    total = total + (g_calls == 0 ? 7 : read(Some(next())));       // 60, call 2
    if (g_calls == 0 && read(Some(next())) > 0) { total = 0; }     // no call
    if (g_calls == 2 || read(Some(next())) > 0) { total = total + 1; } // 61, no call

    i32 turns = 0;
    while (read(Some(next())) < 6) { turns = turns + 1; }          // calls 3..6
    do { turns = turns + 10; } while (read(Some(next())) < 8);     // calls 7, 8
    for (i32 i = 0; read(Some(i)) < 3; i = read(Some(i + 1))) { turns = turns + 100; }

    i32 branch = 0;
    if (g_calls == 8) { branch = 1; } else if (read(Some(next())) > 0) { branch = 2; }
    if (g_calls == 0) { branch = 3; } else if (read(Some(next())) == 9) { branch = branch + 20; }

    if (g_calls == 0) note(Some(next()));
    if (g_calls == 9) note(Some(1));                               // sum 1
    i32 i = 0;
    while (i < 3) note(Some(i = i + 1));                           // sum 7
    case i of { 3 -> note(Some(10)); _ -> note(None); };           // sum 17

    i32 sum_before = 0;
    {
        defer note(Some(100));
        sum_before = g_sum;
    }

    Option<i32> built = same(Some(5));
    i32 matched = case same(Some(6)) of { Some(v) -> v; None -> 0; };
    return (total * 1000 + turns) * 100 + branch +
           (sum_before + g_sum + read(built) + matched) * 10000000;
}
