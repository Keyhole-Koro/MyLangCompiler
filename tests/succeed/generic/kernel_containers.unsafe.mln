import { Slice }
    from "@std/memory/slice.mln";
import { Vec }
    from "@std/collections/vec.mln";
import { Arena }
    from "@std/memory/arena.mln";
import { RingBuffer }
    from "@std/collections/ringbuf.mln";
import { IntrusiveList }
    from "@std/collections/intrusive_list.mln";
import { Option }
    from "@std/core/option.mln";
import { Result }
    from "@std/core/result.mln";
import { result_take_err }
    from "@std/core/result_take.mln";
import { HashMap }
    from "@std/collections/hashmap.mln";
import { Eq }
    from "@std/core/cmp.mln";
import { Hash }
    from "@std/core/hash.mln";

struct Node {
    i32 value;
    Node *next;
};

i32 main() {
    i32 storage[8];
    Vec<i32> values;
    values.init(&storage[0], storage.length);
    values.push(3);
    values.push(4);
    i32 value = 0;
    values.pop(&value);

    Slice<i32> slice;
    slice.init(&storage[0], storage.length);
    i32 *slice_value = slice.at(1).unwrap_or(&value);

    i32 arena_storage[4];
    Arena<i32> arena;
    arena.init(&arena_storage[0], arena_storage.length);
    i32 *allocated = arena.alloc(1);
    *allocated = 20;

    i32 ring_storage[4];
    RingBuffer<i32> ring;
    ring.init(&ring_storage[0], ring_storage.length);
    ring.push(10);
    i32 ring_value = 0;
    ring.pop(&ring_value);

    Option<i32> option = Some(2);
    i32 option_value = case option of {
        Some(value) -> value;
        None -> 0;
    };

    Result<i32, i32> result = Err(7);
    i32 error = 0;
    result_take_err<i32, i32>(&result, &error);

    Node first;
    first.value = 1;
    first.next = (Node *)0;
    Node second;
    second.value = 5;
    second.next = (Node *)0;
    IntrusiveList<Node> list;
    list.init();
    list.push_front(&first, &first.next);
    list.push_front(&second, &second.next);
    Node *front = list.pop_front(&second.next);

    i32 keys[8];
    i32 map_values[8];
    u8 map_used[8];
    HashMap<i32, i32> map;
    map.init(&keys[0], &map_values[0], &map_used[0], keys.length);
    map.put(42, 11);
    i32 none = 0;
    i32 answer = 42;
    i32 mapped = *map.get(&answer).unwrap_or(&none);

    return value + *slice_value + *allocated + ring_value + option_value + error + front->value + mapped;
}
