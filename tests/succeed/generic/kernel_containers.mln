import { Slice }
    from "../../../../MyStdLib/memory/slice.mln";
import { Vec }
    from "../../../../MyStdLib/vec.mln";
import { Arena }
    from "../../../../MyStdLib/memory/arena.mln";
import { RingBuffer }
    from "../../../../MyStdLib/collections/ringbuf.mln";
import { IntrusiveList }
    from "../../../../MyStdLib/collections/intrusive_list.mln";
import { Option, option_take }
    from "../../../../MyStdLib/option.mln";
import { Result, result_take_err }
    from "../../../../MyStdLib/result.mln";
import { HashMap }
    from "../../../../MyStdLib/collections/hashmap.mln";

struct Node {
    i32 value;
    Node *next;
};

i32 main() {
    i32 storage[8];
    Vec<i32> values;
    values.init(&storage[0], storage.length);
    values.push(3);
    values.push(4);
    i32 value = 0;
    values.pop(&value);

    Slice<i32> slice;
    slice.init(&storage[0], storage.length);
    i32 *slice_value = slice.at(1);

    i32 arena_storage[4];
    Arena<i32> arena;
    arena.init(&arena_storage[0], arena_storage.length);
    i32 *allocated = arena.alloc(1);
    *allocated = 20;

    i32 ring_storage[4];
    RingBuffer<i32> ring;
    ring.init(&ring_storage[0], ring_storage.length);
    ring.push(10);
    i32 ring_value = 0;
    ring.pop(&ring_value);

    Option<i32> option = Some(2);
    i32 option_value = 0;
    option_take<i32>(&option, &option_value);

    Result<i32, i32> result = Err(7);
    i32 error = 0;
    result_take_err<i32, i32>(&result, &error);

    Node first;
    first.value = 1;
    first.next = (Node *)0;
    Node second;
    second.value = 5;
    second.next = (Node *)0;
    IntrusiveList<Node> list;
    list.init();
    list.push_front(&first, &first.next);
    list.push_front(&second, &second.next);
    Node *front = list.pop_front(&second.next);

    i32 keys[8];
    i32 map_values[8];
    HashMap<i32> map;
    map.init(&keys[0], &map_values[0], keys.length);
    map.put("answer", 11);
    i32 mapped = 0;
    map.get("answer", &mapped);

    return value + *slice_value + *allocated + ring_value + option_value + error + front->value + mapped;
}
