import allocator from "@std/memory/allocator.mln";
import string from "@std/text/string.mln";
import { String } from "@std/text/string.mln";
import { AllocationError } from "@std/memory/allocator.mln";
import { Result } from "@std/core/result.mln";

u8 storage[256];
i32 used = 0;
i32 frees = 0;

Result<i32, AllocationError> test_alloc(i32 size) {
    if (size <= 0) { return Err(AllocationError::InvalidSize); }
    if (size > 256 - used) { return Err(AllocationError::OutOfMemory); }
    i32 result = (i32)(&storage[used]);
    used = used + size;
    return Ok(result);
}

void test_free(i32 pointer) {
    if (pointer != 0) { frees++; }
}

String greeting() {
    String result = string.with_capacity(2);
    result.append("hello");
    result.push((u8)'!');
    return result;
}

i32 exercise() {
    String text = greeting();
    if (text.as_str() != "hello!") { return 1; }
    if (text.len() != 6) { return 2; }
    str original = text.as_str();
    if (!text.append(original)) { return 3; }
    if (text.as_str() != "hello!hello!") { return 4; }
    if (text.is_empty() || text.capacity_bytes() < 12) { return 5; }
    text.clear();
    if (!text.is_empty() || text.len() != 0) { return 6; }
    return 0;
}

i32 copied() {
    String text = string.from_str("copy");
    if (text.as_str() != "copy") { return 7; }
    return 0;
}

i32 main() {
    allocator.configure(test_alloc, test_free);
    i32 error = exercise();
    if (error == 0) { error = copied(); }
    if (error != 0) { return error; }
    // 2 -> 8 -> 16 frees both old allocations; scope drop frees the final one,
    // and the copy's four bytes.
    return frees * 10 + used;
}
