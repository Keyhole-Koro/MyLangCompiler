void change(borrow mut i32 a, borrow mut i32 b) { *a = *a + 1; *b = *b + 2; }
void read(borrow i32 a, borrow i32 b) { }
i32 main() {
    mut i32 x = 0; mut i32 y = 0;
    read(&x, &x);
    { borrow i32 r = &x; read(r, r); }
    change(&mut x, &mut y);
    change(&mut x, &mut y);
    borrow mut i32 after = &mut x;
    return *after + y;
}
