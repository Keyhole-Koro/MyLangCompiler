// Writes through a `ref mut` parameter or receiver reach the caller's value:
// a reference is a pointer underneath, and `s.v` on one reads through it
// (codegen_lvalue.c). Before, the slot holding the pointer was treated as
// the struct itself and the caller never saw the change.
struct S { i32 v; };

void bump(ref mut S s, i32 d) { s.v = s.v + d; }
void (ref mut S s) twice() { s.v = s.v * 2; }
i32 (ref S s) peek() { return s.v; }

i32 main() {
    mut S s;
    s.v = 1;
    bump(&mut s, 5);        // 6
    s.twice();              // 12
    i32 seen = s.peek();    // 12
    return s.v * 100 + seen;   // 1212
}
