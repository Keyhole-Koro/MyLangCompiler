// A case or a conditional whose value is a struct or a str may be assigned
// to any place, and each arm writes it there: a str local, a global, a field
// or an element; a one-word struct as well. An arm that is a statement
// expression assigns, declares or returns what it yields.
struct Id { i32 v; };
struct Pair { i32 a; i32 b; };
struct Row { i32 id; Pair p; };

Id g_id;
Row g_rows[3];
Pair g_pairs[2];

str assigned(i32 x) {
    str s = "";
    s = case x of {
        0 -> "zero";
        1 -> ({ i32 t = x; yield "one!"; });
        _ -> case x of { 2 -> "tw"; _ -> "many.."; };
    };
    return s;
}

str declared(i32 x) {
    str s = case x of { 0 -> ({ i32 t = 1; yield "a"; }); _ -> "bb"; };
    return s;
}

str returned(i32 x) {
    return x == 0 ? ({ yield "ccc"; }) : "dddd";
}

i32 main() {
    i32 x = 1;
    str label = "";
    label = case x of { 0 -> "zero"; _ -> "other"; };   // 5
    Id a = Id { v: 1 };
    Id b = Id { v: 2 };
    Id r = a;
    r = x == 1 ? b : a;                                  // 2
    g_id = case x of { 1 -> b; _ -> a; };                // 2
    Pair p1 = Pair { a: 3, b: 4 };
    Pair p2 = Pair { a: 5, b: 6 };
    g_rows[x].p = case x of { 0 -> p1; _ -> p2; };       // 11
    g_pairs[x] = x == 1 ? p1 : p2;                       // 7
    str s0 = assigned(0);
    str s1 = assigned(1);
    str s2 = assigned(2);
    str s3 = assigned(3);                                // 4 + 4 + 2 + 6 = 16
    str d0 = declared(0);
    str d1 = declared(1);                                // 1 + 2 = 3
    str t0 = returned(0);
    str t1 = returned(1);                                // 3 + 4 = 7
    i32 small = label.length + r.v * 10 + g_id.v * 100;                          // 225
    i32 places = g_rows[1].p.a + g_rows[1].p.b + (g_pairs[1].a + g_pairs[1].b) * 100;  // 711
    i32 arms = s0.length + s1.length + s2.length + s3.length
             + (d0.length + d1.length) * 100 + (t0.length + t1.length) * 1000;     // 7316
    if (small != 225) return 1000000 + small;
    if (places != 711) return 2000000 + places;
    return arms;
}
