// Annotations are metadata. Each @a(args) on a function or method becomes a
// row -- [name, fn, type, size, argc, arg0..arg2] -- in the module's chunk
// of the `annotations` collected section; the linker gathers every chunk
// into (address, size) pairs between __annotations_start and
// __annotations_end. Nothing calls the annotation prototypes themselves,
// and nothing lists the modules: contributing a chunk keeps an object live.
import counter from "../../support/app/counter.mln";

extern i32 __annotations_start[];
extern i32 __annotations_end[];

i32 is(char *name, char *want) {
    i32 i = 0;
    while (want[i] != 0) { if (name[i] != want[i]) { return 0; } i++; }
    if (name[i] != 0) { return 0; }
    return 1;
}

i32 main() {
    i32 pairs = ((i32)(&__annotations_end[0]) - (i32)(&__annotations_start[0])) / 8;
    if (pairs != 1) { return pairs; }      // one annotated module: counter
    i32 *t = (i32*)__annotations_start[0];
    i32 rows = __annotations_start[1] / 32; // 4
    // row r at r*8: name, fn, type, size, argc, a0, a1, a2
    i32 out = rows * 1000000;
    i32 r = 0;
    while (r < rows) {
        i32 *row = &t[r * 8];
        char *name = (char*)row[0];
        if (is(name, "app") != 0) {
            i32 fn = row[1]; i32 buf[4]; i32 self = (i32)(&buf[0]);
            i32 v = fn(self);                                  // 42
            char *type = (char*)row[2];
            out = out + v * 10000 + row[3] * 100 + row[5] * 10;   // size 16, single 1
            char *label = (char*)row[6];
            if (label[0] == 'C') { out = out + 1; }
            if (type[0] == 'C') { out = out + 2; }
        }
        if (is(name, "timer") != 0) { out = out + row[5]; }   // +100
        if (is(name, "key") != 0) { char *k = (char*)row[5]; if (k[5] == 'S') { out = out + 200; } }
        if (is(name, "mark") != 0) { char *type = (char*)row[2]; if (type[0] == 0) { if (row[3] == 0) { out = out + 400; } } }
        r++;
    }
    return out;   // 4000000 + 420000 + 1600 + 10 + 3 + 100 + 200 + 400 = 4422313
}
