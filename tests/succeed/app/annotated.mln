// Annotations are metadata. Each @a(args) on a function or method becomes a
// row -- [name, fn, type, size, argc, arg0..arg2] -- in the module's chunk
// of the `annotations` collected section; the linker lays every chunk out
// contiguously and lists the section in its directory (`__sections`), so
// MyStdLib's annotations iterator finds the table by name. Nothing calls
// the annotation prototypes themselves, and nothing lists the modules:
// contributing a chunk keeps an object live.
import counter from "../../support/app/counter.mln";
import annotations from "../../../../MyStdLib/meta/annotations.mln";
import { Annotations } from "../../../../MyStdLib/meta/annotations.mln";
import section from "../../../../MyStdLib/memory/section.mln";

i32 main() {
    if (!section.exists("annotations")) { return 1; }
    if (section.exists("nothing")) { return 2; }
    i32 rows = annotations.count();                        // 4
    i32 out = rows * 1000000;

    Annotations it = annotations.named("app");
    while (it.next()) {
        i32 buf[4]; i32 self = (i32)(&buf[0]);
        i32 fn = it.fn();
        i32 v = fn(self);                                  // 42
        out = out + v * 10000 + it.size() * 100 + it.arg(0) * 10;   // size 16, single 1
        char *label = it.text(1);
        if (label[0] == 'C') { out = out + 1; }
        char *type = it.type();
        if (type[0] == 'C') { out = out + 2; }
    }

    Annotations timers = annotations.named("timer");
    while (timers.next()) { out = out + timers.arg(0); }   // +100

    Annotations keys = annotations.where("key", "Counter");
    while (keys.next()) { char *k = keys.text(0); if (k[5] == 'S') { out = out + 200; } }
    Annotations none = annotations.where("key", "Nobody");
    if (none.next()) { return 4; }
    Annotations typed = annotations.of_type("Counter");
    i32 on_counter = 0;
    while (typed.next()) { on_counter++; }
    if (on_counter != 3) { return 5; }                       // app, timer, key

    Annotations marks = annotations.named("mark");
    while (marks.next()) { char *t = marks.type(); if (t[0] == 0) { if (marks.size() == 0) { out = out + 400; } } }

    Annotations all = annotations.all();
    i32 n = 0;
    while (all.next()) { n++; }
    if (n != rows) { return 3; }
    return out;   // 4000000 + 420000 + 1600 + 10 + 3 + 100 + 200 + 400 = 4422313
}
