// Annotations are metadata. Each @a(args) on a function or method becomes a
// row -- [name, fn, type, argc, arg0..arg2] -- in the module's chunk
// of the `annotations` collected section; the linker lays every chunk out
// contiguously and lists the section in its directory (`__sections`), so
// MyStdLib's annotations iterator finds the table by name. Nothing calls
// the annotation prototypes themselves, and nothing lists the modules:
// contributing a chunk keeps an object live.
import counter from "../../support/app/counter.mln";
import annotations from "@std/meta/annotations.mln";
import { Annotations, AnnotationError } from "@std/meta/annotations.mln";
import section from "@std/memory/section.mln";
import { Result } from "@std/core/result.mln";
import { CodeAddress } from "@std/core/address.mln";

i32 annotation_i32(Result<i32, AnnotationError> result) {
    return case result of { Ok(value) -> value; Err(_) -> 0; };
}

CodeAddress annotation_code(Result<CodeAddress, AnnotationError> result) {
    return case result of { Ok(value) -> value; Err(_) -> CodeAddress(0); };
}

str annotation_text(Result<str, AnnotationError> result) {
    return case result of { Ok(value) -> value; Err(_) -> ""; };
}

i32 main() {
    if (!section.exists("annotations")) { return 1; }
    if (section.exists("nothing")) { return 2; }
    i32 rows = annotations.count();                        // 4
    i32 out = rows * 1000000;

    Annotations it = annotations.named("app");
    while (it.next()) {
        i32 buf[4]; i32 self = (i32)(&buf[0]);
        CodeAddress function_address = annotation_code(it.fn());
        fn(i32) -> i32 callback = (fn(i32) -> i32)function_address;
        i32 v = callback(self);                            // 42
        out = out + v * 10000 + annotation_i32(it.arg(0)) * 10;   // single 1
        str label = annotation_text(it.text(1));
        if (label.data[0] == 'C') { out = out + 1; }
        str type = annotation_text(it.type());
        if (type.data[0] == 'C') { out = out + 2; }
    }

    Annotations timers = annotations.named("timer");
    while (timers.next()) { out = out + annotation_i32(timers.arg(0)); }   // +100

    Annotations keys = annotations.where("key", "Counter");
    while (keys.next()) { str k = annotation_text(keys.text(0)); if (k.data[5] == 'S') { out = out + 200; } }
    Annotations none = annotations.where("key", "Nobody");
    if (none.next()) { return 4; }
    Annotations typed = annotations.of_type("Counter");
    i32 on_counter = 0;
    while (typed.next()) { on_counter++; }
    if (on_counter != 3) { return 5; }                       // app, timer, key

    Annotations marks = annotations.named("mark");
    while (marks.next()) { str t = annotation_text(marks.type()); if (t.length == 0) { out = out + 400; } }

    Annotations first = annotations.named("app");
    if (first.row().is_some()) { return 6; }                 // nothing selected yet
    if (!first.next()) { return 7; }
    if (annotation_text(first.name()) != "app") { return 8; }
    if (annotation_i32(first.argc()) != 2) { return 9; }     // single, name
    if (first.row().is_none()) { return 10; }
    first.reset();
    if (first.row().is_some()) { return 11; }
    if (!first.next()) { return 12; }

    Annotations all = annotations.all();
    i32 n = 0;
    while (all.next()) { n++; }
    if (n != rows) { return 3; }
    return out;   // 4000000 + 420000 + 10 + 3 + 100 + 200 + 400 = 4420713
}
