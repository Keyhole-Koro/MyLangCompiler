// An @app struct end to end: the descriptor table, field initializers,
// ref= bindings, defaulted properties and every method attribute, driven
// through the same i32 words the OS framework reads.
package counter;
import dom from "../../support/app/dom.mln";
import { app, timer, key, open, on_close } from "../../support/app/annotations.mln";

@app(single, name = "Counter")
struct Counter { i32 clicks = 0; i32 step = 2; i32 label; i32 win; };

i32 (Counter *c) view() {
    return <Window ref={c->win} title="Counter" w={400}>
        <Label ref={c->label} text="clicks: 0" bold={1} />
        <Button text="Click me" onClick={c->click} />
    </Window>;
}

void (Counter *c) click(i32 id) { c->clicks = c->clicks + c->step; }

@timer(100)
void (Counter *c) poll() { c->clicks = c->clicks + 100; }

@on_close
void (Counter *c) closing() { c->clicks = -1; }

@open
void (Counter *c) open_path(char *path) { c->clicks = (i32)path[0]; }

@key("Ctrl+S")
void (Counter *c) save(i32 id, i32 arg) { c->clicks = c->clicks + arg; }

i32 main() {
    i32 *d = __app_Counter_desc();
    Counter c;
    i32 init = d[3]; init((i32)(&c));
    i32 view = d[4]; i32 win = view((i32)(&c));
    i32 click = dom.last_click();
    click((i32)(&c), dom.last_id(), 0);           // clicks = 2
    i32 timer_fn = d[11]; timer_fn((i32)(&c), 0, 0); // 102
    i32 key_fn = d[13]; key_fn((i32)(&c), 0, 5);   // 107
    i32 open_fn = d[5]; open_fn((i32)(&c), 0, (i32)"A"); // 65
    i32 flags = d[1]; i32 ntimers = d[8]; i32 nkeys = d[9];
    i32 interval = d[10]; char *spec = (char*)d[12]; char *label = (char*)d[0];
    // 65 + flags(1)*1000 + ntimers*100 + nkeys*10 + (interval==100)*10000
    //    + (spec=="Ctrl+S")*20000 + (label=="Counter")*40000 + win + label
    i32 r = c.clicks + flags * 1000 + ntimers * 100 + nkeys * 10;
    if (interval == 100) { r = r + 10000; }
    if (spec[0] == 'C') { if (spec[5] == 'S') { r = r + 20000; } }
    if (label[0] == 'C') { if (label[6] == 'r') { r = r + 40000; } }
    r = r + c.win * 100000 + c.label * 1000000;
    return r;
}
