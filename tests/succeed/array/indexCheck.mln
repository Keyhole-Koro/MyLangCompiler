// Computed indexes inside the bounds of local, global, and field arrays.
struct Grid {
    i32 cells[3];
};

i32 g_values[5];

i32 sum_local(i32 n) {
    i32 a[4];
    i32 i = 0;
    while (i < n) {
        a[i] = i + 1;
        i++;
    }
    i32 total = 0;
    i = 0;
    while (i < n) {
        total = total + a[i];
        i++;
    }
    return total;
}

i32 main() {
    Grid g = Grid {};
    i32 i = 0;
    while (i < 3) {
        g.cells[i] = i * 10;
        i++;
    }
    i = 0;
    while (i < 5) {
        g_values[i] = i;
        i++;
    }
    return sum_local(4) + g.cells[2] + g_values[4];
}
