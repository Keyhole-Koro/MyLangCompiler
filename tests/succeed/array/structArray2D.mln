// A two-dimensional array of structs, global and local: grid[i][j] is a C,
// whose fields read and write in place.
struct C {
    i32 v;
    i32 w;
};
C grid[3][4];
i32 main() {
    C local[2][3];
    grid[1][2].v = 5;
    grid[2][3].w = 7;
    local[1][2].v = 9;
    local[0][1].w = 1;
    return grid[1][2].v * 1000 + grid[2][3].w * 100 + local[1][2].v * 10 + local[0][1].w;
}
