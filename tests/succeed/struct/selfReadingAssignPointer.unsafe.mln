// The pointer forms of selfReadingAssign.mln: the destination and what the
// right side reads are only known at run time to be the same place.
struct P { i32 x; i32 y; };

i32 packed(P p) { return p.x * 100 + p.y; }
void swap_in_place(P* p) { *p = P { x: p->y, y: p->x }; }
P swapped_at(P* p) { return P { x: p->y, y: p->x }; }
i32 next(i32* i) { *i = *i + 1; return 7; }

i32 through_pointer() {
    P v = P { x: 3, y: 5 };
    swap_in_place(&v);
    return packed(v);
}

i32 through_other_name() {
    P v = P { x: 3, y: 5 };
    P* q = &v;
    v = P { x: q->y, y: q->x };
    return packed(v);
}

i32 call_through_pointer() {
    P v = P { x: 3, y: 5 };
    v = swapped_at(&v);
    return packed(v);
}

// The index is evaluated before the right side changes it.
i32 index_before_right_side() {
    P a[2];
    i32 i = 0;
    a[i] = P { x: 5, y: next(&i) };
    return packed(a[0]) - 4;
}

i32 main() {
    i32 wrong = 0;
    if (through_pointer() != 503) { wrong = wrong + 1; }
    if (through_other_name() != 503) { wrong = wrong + 2; }
    if (call_through_pointer() != 503) { wrong = wrong + 4; }
    if (index_before_right_side() != 503) { wrong = wrong + 8; }
    return 1000 + wrong;
}
