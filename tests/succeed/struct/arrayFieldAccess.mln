// Array fields can be indexed through both a value and a pointer to the
// containing struct.  This is needed by stateful app objects: buffers belong
// to the instance instead of being module globals.

typedef struct {
    i32 values[4];
    char text[4];
} Buffer;

i32 main() {
    Buffer b;
    b.values[0] = 3;
    b.values[1] = 5;
    b.text[0] = 'A';

    Buffer *p = &b;
    p->values[2] = p->values[0] + p->values[1];
    p->text[1] = p->text[0] + 1;

    return p->values[2] + p->text[1]; // 8 + 'B' (66) = 74
}
