// A plain parameter reads through a `borrow`, and an argument is evaluated
// before the call lends anything.
struct S { i32 v; };
i32 (S s) get() { return s.v; }
void (borrow S s) set(i32 value) { s.v = value; }
i32 read(S s) { return s.get(); }
void (borrow S s) bump() { s.set(s.get() + read(s)); }
i32 main() { S s; s.set(3); s.bump(); return s.v; }
