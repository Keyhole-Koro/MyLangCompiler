// `&` marks an argument that can change, and it is the same mark for a variable
// and for a borrow: `&b` on a borrow names the place it already is. A receiver
// needs no mark, and a plain parameter reads through a borrow.
struct Counter { i32 value; };

void (borrow Counter c) add(i32 by) { c.value = c.value + by; }
i32 (Counter c) get() { return c.value; }

void bump(borrow i32 n) { n = n + 1; }
void bump_twice(borrow i32 n) { bump(&n); bump(&n); }
i32 read(i32 value) { return value * 10; }
i32 read_through(borrow i32 n) { return read(n); }

void add_three(borrow Counter c) {
    c.add(1);                 // receivers stay automatic
    grow(&c);
    c.add(c.get());           // 3 + 3
}
void grow(borrow Counter c) { c.value = c.value + 2; }

i32 main() {
    i32 n = 0;
    bump_twice(&n);                             // 2
    Counter c = Counter { value: 0 };
    add_three(&c);                              // 6
    i32 local = 4;
    {
        borrow i32 r = &local;
        bump(&r);                               // 5
        borrow i32 same = &r;
        same = same + 1;                        // 6
    }
    return n * 10000 + c.value * 1000 + local * 100 + read_through(&n);
}
