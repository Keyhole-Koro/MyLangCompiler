// for-in asks an Iterator for items until next() returns None; a local
// iterator is advanced in place, and break/continue behave as in any loop.
import { Option } from "@std/core/option.mln";
import { Iterator } from "@std/core/iter.mln";

struct Range { i32 cur; i32 end; };

impl Iterator<i32> for Range {
    Option<i32> (Range *self) next() {
        if (self->cur >= self->end) { return None; }
        i32 v = self->cur;
        self->cur = self->cur + 1;
        return Some(v);
    }
}

struct Pair { i32 a; i32 b; };
struct Pairs { i32 i; };

impl Iterator<Pair> for Pairs {
    Option<Pair> (Pairs *self) next() {
        if (self->i >= 3) { return None; }
        self->i = self->i + 1;
        return Some(Pair { a: self->i, b: self->i * 10 });
    }
}

Range range(i32 a, i32 b) { return Range { cur: a, end: b }; }

i32 main() {
    i32 sum = 0;
    for (i32 x in range(1, 5)) {
        sum = sum + x;                    // 1+2+3+4 = 10
    }
    Range r = Range { cur: 0, end: 10 };
    for (i32 x in r) {
        if (x == 3) { continue; }
        if (x == 6) { break; }
        sum = sum + x * 100;              // (0+1+2+4+5)*100 = 1200
    }
    i32 left = r.cur;                     // 7: the break came after next() returned 6
    Pairs ps = Pairs { i: 0 };
    for (Pair p in ps) {
        sum = sum + p.b * 1000;           // (10+20+30)*1000 = 60000
    }
    return sum + left * 1000000;          // 7061210
}
