// dyn values made in one module are dispatched by another.
import { Shape } from "dynCross_lib.mln";
import shapes2 from "dynCross_lib.mln";

struct Square { i32 side; };
impl Shape for Square {
    i32 (Square *self) area() { return self->side * self->side; }
}

i32 main() {
    Square a = Square { side: 2 };
    Square b = Square { side: 5 };
    dyn Shape items[2];
    items[0] = &a;
    items[1] = &b;
    return shapes2.total(&items[0], 2);
}
