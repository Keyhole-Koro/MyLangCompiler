// An exported generic impl is instantiated in the module that uses it.
import { Box } from "genericImplCross_lib.mln";

i32 main() {
    Box<i32> a = Box<i32> { value: 7 };
    Box<i32> b = Box<i32> { value: 7 };
    Box<u8> c = Box<u8> { value: (u8)1 };
    Box<u8> d = Box<u8> { value: (u8)2 };
    i32 r = 0;
    if (a == b) { r = r + 10; }
    if (c != d) { r = r + 1; }
    return r;
}
