// `dyn Trait` values dispatch through the impl of whatever they were made
// from. A `T *` becomes one wherever a dyn value is expected.
import { Option } from "@std/core/option.mln";
import { Iterator } from "@std/core/iter.mln";

trait Shape {
    i32 (Self *self) area();
    i32 (Self *self) scaled(i32 k) { return self.area() * k; }
}

struct Square { i32 side; };
struct Rect { i32 w; i32 h; };

impl Shape for Square {
    i32 (Square *self) area() { return self->side * self->side; }
}
impl Shape for Rect {
    i32 (Rect *self) area() { return self->w * self->h; }
    i32 (Rect *self) scaled(i32 k) { return self->w * self->h * k + 1; }
}

struct Labeled { dyn Shape shape; i32 label; };

i32 total(dyn Shape *shapes, i32 n) {
    i32 sum = 0;
    for (i32 i = 0; i < n; i++) { sum = sum + shapes[i].area(); }
    return sum;
}

i32 area_of(dyn Shape s) { return s.area(); }

dyn Shape pick(Square *sq, Rect *r, i32 which) {
    if (which == 0) { return sq; }
    return r;
}

struct Countdown { i32 n; };
impl Iterator<i32> for Countdown {
    Option<i32> (Countdown *self) next() {
        if (self->n == 0) { return None; }
        self->n = self->n - 1;
        return Some(self->n + 1);
    }
}

i32 sum_all(dyn Iterator<i32> it) {
    i32 sum = 0;
    while (1) {
        Option<i32> v = it.next();
        i32 more = case v of { Some(x) -> x; None -> 0; };
        if (more == 0) { break; }
        sum = sum + more;
    }
    return sum;
}

i32 main() {
    Square sq = Square { side: 3 };
    Rect r = Rect { w: 2, h: 5 };

    dyn Shape shapes[2];
    shapes[0] = &sq;
    shapes[1] = &r;
    i32 a = total(&shapes[0], 2);              // 9 + 10 = 19

    dyn Shape s = &r;
    i32 b = s.scaled(2) + area_of(&sq);        // 21 + 9 = 30

    dyn Shape chosen = pick(&sq, &r, 0);
    Labeled l = Labeled { shape: &r, label: 4 };
    i32 c = chosen.area() + l.shape.area();     // 9 + 10 = 19

    Countdown cd = Countdown { n: 3 };
    i32 d = sum_all(&cd);                       // 3 + 2 + 1 = 6

    return a * 1000000 + b * 10000 + c * 100 + d;
}
