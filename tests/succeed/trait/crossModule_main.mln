// Exported impls travel to an importer once their type is visible there.
import { P, LibErr, RawErr, Counter } from "crossModule_lib.mln";
import { Option } from "@std/core/option.mln";
import { Result } from "@std/core/result.mln";

Result<i32, RawErr> raw(i32 x) {
    if (x == 0) { return Err(RawErr::R2); }
    return Ok(x);
}

Result<i32, LibErr> f(i32 x) {
    i32 v = raw(x)?;
    return Ok(v + 1);
}

i32 main() {
    i32 r = 0;
    P a = P { x: 1, y: 2 };
    P b = P { x: 1, y: 2 };
    if (a == b) { r = r + 1; }
    Result<i32, LibErr> e = f(0);
    i32 code = case e of { Ok(_) -> 0; Err(LibErr::Bad(c)) -> c; Err(_) -> 1; };
    r = r + code * 10;                         // 420
    Result<i32, LibErr> ok = f(5);
    r = r + (case ok of { Ok(v) -> v; Err(_) -> 0; }) * 1000;   // 6000
    Counter c = Counter { n: 4 };
    i32 s = 0;
    for (i32 v in c) { s = s + v; }            // 3+2+1+0 = 6
    LibErr d = LibErr::from(RawErr::R1);
    i32 w = case d of { LibErr::Worse -> 1; _ -> 0; };
    return r + s * 100000 + w * 10000000;      // 10606421
}
