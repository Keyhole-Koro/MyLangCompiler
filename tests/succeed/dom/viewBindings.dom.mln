// A property that reads the receiver of `view` is bound: `bind` records its
// node, and the generated `__view_update` hands the value to the hook
// `<Tag>_<property>` each time it runs. A format lowers to the format hooks,
// and a Text<N> field goes to a `str` property as a `str`.
import { Text } from "@std/text/text.mln";

struct Counter { i32 clicks; bool on; Text<8> name; };

i32 g_nodes[4];
i32 g_next = 1;
i32 g_shown = 0;
i32 g_named = 0;
i32 g_checked = -1;
i32 g_format = 0;

void bind(i32 slot, i32 node) { g_nodes[slot] = node; }
void append_child(i32 parent, i32 child) { }

i32 Window(str title) { g_next = g_next + 1; return g_next; }
i32 Label(str text, i32 x = 0, i32 y = 0, i32 w = 0) { g_next = g_next + 1; return g_next; }
i32 Checkbox(bool checked) { g_next = g_next + 1; return g_next; }

void Label_text(i32 slot, str value) {
    if (slot == 0) { g_shown = g_nodes[slot] * 100 + value.length; }
    else { g_named = g_nodes[slot] * 100 + value.length; }
}
void Checkbox_checked(i32 slot, bool value) { g_checked = value ? g_nodes[slot] : 0; }

str format(str text) { g_format = 1; return text; }
str format_int(str left, i32 value) { g_format = g_format * 10 + value; return left; }
str format_str(str left, str value) { g_format = g_format * 10 + value.length; return left; }
str format_end(str left) { return left; }

i32 (Counter c) view() {
    return <Window title="t">
        <Label text={"a %d b %s %%", c.clicks, c.name} />
        <Label text="static" />
        <Label text={c.name} />
        <Checkbox checked={c.on} />
    </Window>;
}

i32 main() {
    Counter c = Counter { clicks: 4, on: true };
    c.name.append("xyz");
    c.view();
    c.__view_update();
    i32 first = g_shown * 1000 + g_format;     // 312 * 1000 + 143
    c.clicks = 5;
    c.name.append("w");
    c.on = false;
    c.__view_update();
    return first * 10000 + g_named * 10 + g_checked + g_format;  // ... + 504 * 10 + 0 + 154
}
