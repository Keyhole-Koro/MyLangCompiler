// `from`, `of`, `rest`, `namespace` and `package` are keywords only where an
// import, a case, a variadic parameter or the namespace line puts them.
namespace words;
import { Text } from "@std/text/text.mln";

struct Span { i32 from; i32 of; i32 rest; i32 namespace; i32 package; };

i32 (Span self) rest() { return self.rest; }

i32 from(i32 x) { return x + 1; }

i32 sum(i32 from, i32 of, i32 rest, i32 namespace, i32 package) {
    return from + of + rest + namespace + package;
}

i32 count(i32 n, rest r) { return n + __rest_len(r); }

void each(fn(i32, rest) -> void visit) { }

i32 pick(i32 of) {
    return case of of { 1 -> 10; _ -> 20; };
}

i32 main() {
    i32 rest = 3;
    i32 namespace = 4;
    i32 package = 5;
    Span s = Span { from: 1, of: 2, rest: rest, namespace: namespace, package: package };
    i32 total = sum(s.from, s.of, s.rest(), s.namespace, s.package);
    for (i32 of = 0; of < 2; of++) { total = total + of; }
    return total + pick(1) + count(1, 7, 8) + from(0);
}
